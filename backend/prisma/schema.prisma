// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  // Optional now: Google-only accounts have no password.
  password String?

  // Email verification
  emailVerified           Boolean   @default(false)
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?

  // Google OAuth
  googleId String? @unique

  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]
  sessions      Session[]
}

model RefreshToken {
  id          String   @id @unique @default(uuid())
  hashedToken String   @unique
  userId      String
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expireAt    DateTime
}

model Exercise {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String
  mechanic         String? // "compound" | "isolation"
  force            String? // "push" | "pull" | "static"
  videoUrl         String?
  gifUrl           String?
  muscleDiagramUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  difficultyId String
  difficulty   Difficulty @relation(fields: [difficultyId], references: [id])

  bodyAreaId String?
  bodyArea   BodyArea? @relation(fields: [bodyAreaId], references: [id])

  muscleGroups  ExerciseMuscleGroup[]
  equipment     ExerciseEquipment[]
  exerciseTypes ExerciseExerciseType[]
  sessions      Session[]
}

model Difficulty {
  id   String @id @default(uuid())
  name String @unique // "light" | "easy" | "normal" | "hard" | "advanced"

  exercises Exercise[]
}

model BodyArea {
  id   String @id @default(uuid())
  name String @unique // e.g. "abs" | "upper-body" | "lower-body" | "full-body" | "back"

  exercises Exercise[]
}

model MuscleGroup {
  id   String @id @default(uuid())
  name String @unique

  exercises ExerciseMuscleGroup[]
}

model Equipment {
  id   String @id @default(uuid())
  name String @unique

  exercises ExerciseEquipment[]
}

model ExerciseType {
  id   String @id @default(uuid())
  name String @unique

  exercises ExerciseExerciseType[]
}

model ExerciseMuscleGroup {
  id            String      @id @default(uuid())
  exerciseId    String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, muscleGroupId])
}

model ExerciseEquipment {
  id          String    @id @default(uuid())
  exerciseId  String
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, equipmentId])
}

model ExerciseExerciseType {
  id             String       @id @default(uuid())
  exerciseId     String
  exercise       Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseTypeId String
  exerciseType   ExerciseType @relation(fields: [exerciseTypeId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, exerciseTypeId])
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDuration   Int       @default(1500)
  breakDuration  Int       @default(300)
  exerciseId     String?
  Exercise       Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  status         String    @default("in_progress")
  startedAt      DateTime  @default(now())
  breakStartedAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, startedAt])
}
