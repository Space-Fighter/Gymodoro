// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique

  // Optional now: Google-only accounts have no password.
  password  String?

  // Email verification
  emailVerified            Boolean   @default(false)
  verificationToken        String?   @unique
  verificationTokenExpiry  DateTime?

  // Google OAuth
  googleId  String?  @unique

  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]
  sessions      Session[]
}

model RefreshToken {
  id          String   @id @unique @default(uuid())
  hashedToken String   @unique
  userId      String
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expireAt    DateTime
}

model Exercise {
  id             String    @id @default(uuid())
  name           String
  description    String
  category       String
  difficulty     String
  duration       Int       @default(300)
  caloriesBurned Int       @default(20)
  imageUrl       String?
  instructions   String?
  createdAt      DateTime  @default(now())

  sessions       Session[]
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDuration   Int       @default(1500)
  breakDuration  Int       @default(300)
  exerciseId     String?
  Exercise       Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  status         String    @default("in_progress")
  startedAt      DateTime  @default(now())
  breakStartedAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, startedAt])
}

